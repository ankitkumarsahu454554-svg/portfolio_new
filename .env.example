# ==============================================================================
# LIQUID / FORM — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# This application is architected to run completely out-of-the-box without requiring
# any mandatory environment variables. All static assets, WebGL shaders, routes,
# and personal resume/profile documents are bundled directly.
#
# If you integrate third-party services in the future (e.g., Vercel Analytics,
# Resend API for the contact form, or external analytics), configure them below.
#
# IMPORTANT:
# - Never commit actual .env or .env.local files containing private secrets to git.
# - Keep this .env.example file populated ONLY with variable names and safe placeholders.
# ==============================================================================

# Public Site URL (used for canonical URLs and dynamic sitemaps)
NEXT_PUBLIC_SITE_URL=https://liquidform.studio

# [Optional] Vercel Analytics / Speed Insights
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# [Optional] Email Delivery Service (e.g. Resend) for contact form dispatch
# RESEND_API_KEY=
# CONTACT_NOTIFICATION_EMAIL=ankitkumarsahu488526@gmail.com

