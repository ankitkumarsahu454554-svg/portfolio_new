# ==============================================================================
# ANKIT KUMAR SAHU — PORTFOLIO ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# All static assets, routes, and personal resume/profile documents are bundled directly.
# The contact form works with direct mailto fallback out-of-the-box.
#
# To enable direct in-app email dispatch:
# 1. Sign up at https://resend.com (free 3,000 emails/month)
# 2. Add RESEND_API_KEY below or in your Vercel Project Settings > Environment Variables
#
# IMPORTANT:
# - Never commit actual .env or .env.local files containing private secrets to git.
# - Keep this .env.example file populated ONLY with variable names and safe placeholders.
# ==============================================================================

# Public Site URL (used for OpenGraph and dynamic sitemaps)
NEXT_PUBLIC_SITE_URL=https://portfolio-new.vercel.app

# Email Delivery Service (Resend)
# RESEND_API_KEY=re_123456789_placeholder
# CONTACT_TO_EMAIL=ankitkumarsahu488526@gmail.com
# CONTACT_FROM_EMAIL=onboarding@resend.dev

# Alternative Email Dispatch (Formspree)
# FORMSPREE_FORM_ID=xpznwxyb


